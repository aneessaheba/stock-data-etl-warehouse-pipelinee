# PostgreSQL / TimescaleDB connection
# These defaults match docker-compose.yml.
# For local runs (without Docker), set DB_HOST=localhost and ensure
# TimescaleDB or plain PostgreSQL is running on port 5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockdw
DB_USER=data226
DB_PASSWORD=12345678

# Kafka broker address (used by streaming/producer.py and consumer.py)
# Override only when running outside Docker.
KAFKA_BROKER=localhost:9092
